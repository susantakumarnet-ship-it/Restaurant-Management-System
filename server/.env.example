# ---------------------------------------------------------------
# Smart RMS API configuration. Copy to .env and adjust.
# Everything is optional for local development.
# ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:5173
PUBLIC_URL=http://localhost:4000
# Restaurant local timezone (booking times are stored as local wall-clock time)
TZ=Asia/Kolkata

# --- Database (MongoDB) ---
# Production: MongoDB Atlas connection string (Atlas -> Database -> Connect -> Drivers). REQUIRED when NODE_ENV=production.
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=rms
MONGODB_DB=rms
# Development without MONGODB_URI: a local MongoDB is started automatically (mongodb-memory-server)
# and stored in this folder. Demo data is loaded on first run.
MONGO_DATA_DIR=./data/mongo
DB_POOL_MAX=10

# --- Auth ---
# REQUIRED in production: a long random string (e.g. `openssl rand -hex 48`)
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRES_IN=1d
# Return OTP codes in API responses (dev only; always false in production)
EXPOSE_OTP=true

# --- Uploads (local disk; swap storage in src/routes/uploads.js for S3/GCS/Cloudinary) ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# --- Rate limiting (requests per 15 minutes per IP) ---
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=30

# --- Razorpay (leave empty to use the built-in mock gateway) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (SMTP). Empty = messages are recorded with status "logged" ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Smart RMS <no-reply@yourdomain.com>"

# --- SMS (Twilio-compatible) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WhatsApp Business (Meta Cloud API) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Google Sign-In (optional) ---
GOOGLE_CLIENT_ID=

# Booking reminder scheduler (every 5 min)
SCHEDULER_ENABLED=true
